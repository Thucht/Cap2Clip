{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cap2Clip",
  "version": "1.0.0",
  "identifier": "com.thucht.cap2clip",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "trayIcon": {
      "iconPath": "../icon.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Cap2Clip",
        "width": 1200,
        "height": 800,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "focus": false
      },
      {
        "label": "settings",
        "title": "Cap2Clip Settings",
        "url": "index.html?window=settings",
        "width": 640,
        "height": 720,
        "minWidth": 520,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "skipTaskbar": false,
        "focus": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../icon.png",
      "../icon.ico"
    ],
    "resources": [],
    "publisher": "Thucht Software",
    "copyright": "Copyright © 2026 Thucht Software. All rights reserved.",
    "category": "Utility",
    "shortDescription": "Fast screenshot capture and annotation for Windows.",
    "longDescription": "Cap2Clip is a lightweight screenshot capture and annotation utility for fast region capture, markup, copying, and saving.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
