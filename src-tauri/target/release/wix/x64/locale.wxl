<WixLocalization Culture="en-us" xmlns="http://schemas.microsoft.com/wix/2006/localization"><String Id="TauriLanguage">1033</String><String Id="TauriCodepage">1252</String><String Id="LaunchApp">Launch Lightshot Clone</String><String Id="DowngradeErrorMessage">A newer version of Lightshot Clone is already installed.</String><String Id="PathEnvVarFeature">Add the install location of the Lightshot Clone executable to the PATH system environment variable. This allows the Lightshot Clone executable to be called from any location.</String><String Id="InstallAppFeature">Installs Lightshot Clone.</String></WixLocalization>